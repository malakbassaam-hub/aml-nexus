# Copy to .streamlit/secrets.toml for local runs, or paste into Streamlit Cloud > App settings > Secrets.
# Use PayPal SANDBOX credentials only. Never commit the real file.
[paypal]
client_id = "YOUR_SANDBOX_CLIENT_ID"
client_secret = "YOUR_SANDBOX_SECRET"

# OPTIONAL: grounded AI case summaries (an LLM that may only restate the evidence). Without any key a fixed template is shown, labelled "not AI".
# Free option: create a key in Google AI Studio (aistudio.google.com) and check which model names your free tier offers.
# [gemini]
# api_key = "YOUR_GOOGLE_AI_STUDIO_KEY"
# model = "gemini-2.5-flash-lite"
#
# Alternative (paid): Anthropic API
# [anthropic]
# api_key = "YOUR_API_KEY"
# model = "claude-haiku-5-5"
